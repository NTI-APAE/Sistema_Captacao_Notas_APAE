FROM python:3.12.8-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY __init__.py evolution.py notas.py webhook.py ./EvolutionAPI/

USER nobody

EXPOSE 8001

CMD ["uvicorn", "EvolutionAPI.webhook:app", "--host", "0.0.0.0", "--port", "8001"]
