DATABASE_URL=postgresql+psycopg://notas_apae:notas_apae@localhost:5433/notas_apae
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_API_KEY=change-me
EVOLUTION_INSTANCE=default
N8N_WEBHOOK_URL=http://localhost:5678/webhook/notas
PRAZO_MAXIMO_EMISSAO_MESES=3
LOG_LEVEL=INFO
WORKER_API_KEY=change-me-worker-key
WORKER_MAX_ATTEMPTS=3
WORKER_EXECUTION_TIMEOUT_MINUTES=30

# Opcional: chave exclusiva de integracao (mesmo valor nos dois processos).
# Chave usada pelo webhook para chamar a API de notas. Nunca publicar este segredo.
NOTAS_API_INTERNAL_KEY=

# Opcional: caminho do executável Tesseract OCR quando ele não estiver no PATH.
TESSERACT_CMD=

# Sessão administrativa. Use true em produção HTTPS.
ADMIN_SESSION_COOKIE=apae_session
ADMIN_SESSION_MINUTES=480
ADMIN_COOKIE_SECURE=false
