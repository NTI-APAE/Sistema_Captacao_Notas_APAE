# Copie para production.env fora do Git e injete os valores por um secret store.
APP_ENV=production

NOTES_DB_IMAGE=postgres:16.4-alpine
NOTES_DB_NAME=notas_apae
NOTES_DB_USER=notas_apae
NOTES_DB_PASSWORD=REPLACE_WITH_SECRET
DATABASE_URL=postgresql+psycopg://notas_apae:REPLACE_WITH_SECRET@notes-db:5432/notas_apae

WORKER_API_KEY=REPLACE_WITH_SECRET
NOTAS_API_INTERNAL_KEY=REPLACE_WITH_SECRET
ADMIN_SESSION_COOKIE=apae_session
ADMIN_SESSION_MINUTES=480

EVOLUTION_DB_IMAGE=postgres:15.10-alpine
EVOLUTION_DB_NAME=evolution
EVOLUTION_DB_USER=evolution
EVOLUTION_DB_PASSWORD=REPLACE_WITH_SECRET
REDIS_IMAGE=redis:7.4.2-alpine
EVOLUTION_API_IMAGE=REPLACE_WITH_APPROVED_TAG_OR_DIGEST
EVOLUTION_ENV_FILE=./evolution-api.env
EVOLUTION_INSTANCE=REPLACE_WITH_INSTANCE
EVOLUTION_API_KEY=REPLACE_WITH_SECRET
EVOLUTION_WEBHOOK_TOKEN=REPLACE_WITH_SECRET

LOG_LEVEL=INFO
PRAZO_MAXIMO_EMISSAO_MESES=3
WORKER_MAX_ATTEMPTS=3
WORKER_EXECUTION_TIMEOUT_MINUTES=30
WORKER_HEARTBEAT_INTERVAL_SECONDS=30
WORKER_LEASE_TIMEOUT_SECONDS=120
